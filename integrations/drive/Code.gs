// Script property ROSTER_FOLDER_ID points to a restricted Drive folder containing
// only JSON generated by the local importer. No Drive identifiers are returned.
function doGet(event) {
  const school = String(event?.parameter?.school || '').trim().toUpperCase();
  const output = value => ContentService.createTextOutput(JSON.stringify(value))
    .setMimeType(ContentService.MimeType.JSON);
  if (!/^[A-Z]{3}[0-9]{4}$/.test(school)) return output({ error: 'Invalid school' });

  try {
    const folderId = PropertiesService.getScriptProperties().getProperty('ROSTER_FOLDER_ID');
    if (!folderId) return output({ lists: [] });

    const cache = CacheService.getScriptCache();
    const key = 'pu-roster-v1:' + folderId + ':' + school;
    const saved = cache.get(key);
    if (saved) return ContentService.createTextOutput(saved).setMimeType(ContentService.MimeType.JSON);

    const files = DriveApp.getFolderById(folderId).getFiles();
    const latest = {};
    while (files.hasNext()) {
      const file = files.next();
      const parts = /^(students|teachers)-(\d{4}-\d{2}-\d{2})_(\d{4}-\d{2}-\d{2})\.json$/.exec(file.getName());
      if (!parts) continue;
      const [, kind, end, start] = parts;
      const periodKey = end + '_' + start;
      const modified = file.getLastUpdated().getTime();
      const prior = latest[kind];
      if (!prior || periodKey > prior.periodKey || (periodKey === prior.periodKey && modified > prior.modified)) {
        latest[kind] = { file, periodKey, modified, end, start };
      }
    }

    const lists = [];
    for (const kind of ['students', 'teachers']) {
      const current = latest[kind];
      if (!current) continue;
      const report = JSON.parse(current.file.getBlob().getDataAsString('UTF-8'));
      if (report.kind !== kind || report.period?.start !== current.start || report.period?.end !== current.end) {
        throw new Error('Invalid roster');
      }
      const names = report.schools?.[school];
      if (!Array.isArray(names)) continue;
      lists.push({ kind, label: String(report.period.label), names: names.filter(name => typeof name === 'string') });
    }
    const payload = JSON.stringify({ lists });
    if (Utilities.newBlob(payload).getBytes().length < 95000) cache.put(key, payload, 90);
    return ContentService.createTextOutput(payload).setMimeType(ContentService.MimeType.JSON);
  } catch (_) {
    return output({ error: 'Lists temporarily unavailable' });
  }
}
